# Шаблон настроек Episodio. Скопируй в .env (cp .env.example .env) и подставь свои значения.
# Файл .env в git не попадает, секреты храни только в нём.

# Подключение к PostgreSQL
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=episodio_db

# Готовая строка подключения. Необязательна: если задана, имеет приоритет над DB_*.
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/episodio_db

# Отдельная база для тестов (создай её заранее: CREATE DATABASE episodio_test;)
TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/episodio_test

# Общий секрет API. Если задан, все запросы (кроме /health, / и /posters/...) должны нести заголовок X-API-Key.
# Если пуст или закомментирован, защита выключена. Фронтенд подставляет ключ на сервере Next.js.
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
# API_KEY=

# Фронтенд (Next.js) ходит в API через свой сервер-прокси. Адрес FastAPI (по умолчанию http://127.0.0.1:8000)
# и тот же API_KEY, что выше (подставляется в заголовок X-API-Key на сервере Next.js, в браузер не попадает).
# API_URL=http://127.0.0.1:8000

# Ключ TMDB для обогащения карточек (бесплатный: https://www.themoviedb.org/settings/api).
# Подходит и короткий «API Key», и длинный «API Read Access Token».
TMDB_API_KEY=

# Ключ TheTVDB v4 (https://thetvdb.com/dashboard/account/apikey). Источник для сериалов и фильмов: берётся сам, если
# TMDB_API_KEY не задан, или явно (--source tvdb). PIN нужен только для ключей с подпиской (user supported key).
TVDB_API_KEY=
# TVDB_PIN=





# AI-компаньон «Эпи» (экран /ai): модель DeepSeek (https://platform.deepseek.com) и веб-поиск Tavily (https://tavily.com).
# Без DEEPSEEK_API_KEY чат отвечает 503; без TAVILY_API_KEY Эпи работает, но не ищет в интернете.
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
TAVILY_API_KEY=

# Shikimori (аниме и манга): ключ не нужен, но запросы нужно подписывать названием приложения.
SHIKIMORI_USER_AGENT=Episodio

# Open Library (книги и аудиокниги): необязательно. С контактом лимит выше (3 запроса в секунду вместо 1).
# OPENLIBRARY_USER_AGENT=Episodio (you@example.com)

# Вход во фронтенд (frontend/). Страница /login сверяет логин и пароль с этими значениями.
# Сервер Next.js читает этот же .env из корня проекта. Без этих трёх переменных вход отвечает 503.
AUTH_LOGIN=
AUTH_PASSWORD=
# Секрет подписи cookie-сессии: случайная строка от 32 символов.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Публичные витрины (/u/<имя>/<адрес>): имя владельца в ссылке. Латиница в нижнем регистре, цифры, «-» и «_», до 32 символов.
# Это не логин для входа: логин в публичные ссылки не попадает. По умолчанию me.
# PUBLIC_HANDLE=me


# --- Docker (docker-compose.yml, развёртывание на сервере) ---
# В Docker адрес базы и API подставляет compose (db, api), а DB_USER/DB_PASSWORD/DB_NAME задают пользователя базы.
# https и домен обслуживает ваш Caddy, который уже стоит на сервере.
# Задайте надёжный DB_PASSWORD (выше), API_KEY и AUTH_*.
# Имя внешней docker-сети, в которой работает Caddy сервера. По умолчанию web_gateway.
# PROXY_NETWORK=web_gateway
# Автобэкап: как часто (часов) и сколько копий хранить (папка ./backups рядом с docker-compose.yml)
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14
